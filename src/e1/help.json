{
  "title": "E-1",
  "children": [
    { "title": "Overview", "lines": [
      "16 Euclidean tracks.",
      "Top 16 pads: tracks.",
      "Bottom 16: a view,",
      "picked with the 4",
      "left-edge buttons.",
      "Knobs: current page.",
      "Jog: page. Click:",
      " back to Rhythm." ] },
    { "title": "Tracks", "lines": [
      "Tap: select.",
      "Hold: knobs, +/- and",
      " perform pads act on",
      " held tracks only.",
      "Shift+tap: mute.",
      "Copy+tap+tap: copy.",
      "Delete+tap: clear." ] },
    { "title": "Steps", "lines": [
      "Step row = selected",
      "track. Tap: add or",
      " remove a hit.",
      "Shift+tap: Steps.",
      "Loop+tap: freeze",
      " that many steps.",
      "Left/Right: 17-64.",
      "Shift+L/R: rotate.",
      "+/-: pulses.",
      "Shift +/-: steps." ] },
    { "title": "Views", "lines": [
      "1 Values: choices",
      " for the last knob.",
      "2 Perform: hold a",
      " pad. Shift latches.",
      " Press 2 again:",
      " all moves off.",
      "3 Mutes: tap mutes,",
      " Shift+tap solos.",
      "4 Patterns: tap",
      " plays on the bar,",
      " tap again = now.",
      " Shift+tap saves." ] },
    { "title": "Undo and Temp", "lines": [
      "Hold Sample: Temp.",
      " Edits undo when",
      " you let go.",
      " Capture keeps them.",
      "Capture: save to",
      " next empty pattern.",
      "Undo: step back." ] },
    { "title": "Play and clock", "lines": [
      "Play: start/stop.",
      "Shift+Play: clock",
      " Move/Internal/PC.",
      "Shift+jog: tempo",
      " (Internal only).",
      "Menu: settings.",
      "Shift+Menu: output",
      " Move/PC/Both." ] },
    { "title": "Exit", "lines": [
      "Back: hide, keeps",
      " playing.",
      "Shift+Back: quit.",
      "Saved to",
      "UserData/schwung/e1" ] }
  ]
}
