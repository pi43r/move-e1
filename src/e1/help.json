{
  "title": "E-1",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "16 Euclidean tracks.",
        "Top 16 pads: tracks.",
        "Step row: pulses of",
        " the selected track.",
        "Bottom 16 pads: the",
        " last knob touched.",
        "Knobs: the page.",
        "Shift: 2nd function.",
        "Jog: page.",
        "Jog click: home.",
        "Shift+jog: tempo.",
        "Knob LEDs: rows 1-4",
        " and 5-8. White =",
        " the knob selected.",
        "Named values show",
        " a list as you turn."
      ]
    },
    {
      "title": "Knob pages",
      "lines": [
        "Left page, knobs:",
        "1 Steps  2 Pulses",
        "3 Cycles 4 Div",
        "5 Repeat 6 Time",
        "7 Voicing 8 Range",
        "Right page:",
        "1 Vel  2 Sustain",
        "3 Pitch 4 Length",
        "5 Accent 6 Timing",
        "7 Scale 8 Chan",
        "Shift: 2nd function.",
        "Tempo: Shift+jog."
      ]
    },
    {
      "title": "Lights",
      "lines": [
        "Selected track:",
        " bright orange, or",
        " cyan for CC.",
        "Other tracks on:",
        " same colour, very",
        " dim.",
        "Muted: off.",
        "White: sounding,",
        " current value.",
        "Blue: triplets,",
        " patterns.",
        "Green: bars,",
        " styles, grooves.",
        "Pink: modifiers.",
        "Red: edited."
      ]
    },
    {
      "title": "Tracks",
      "lines": [
        "Tap: select.",
        "Tap the selected",
        " track: hear one",
        " hit of it.",
        "Hold one or more:",
        " knobs, value pads",
        " and perform act on",
        " the held tracks.",
        "Shift+tap: mute now.",
        "Copy+tap+tap: copy.",
        "Delete+tap: clear."
      ]
    },
    {
      "title": "Steps",
      "lines": [
        "Tap: toggle a step.",
        "Shift+step: edit",
        " only that step.",
        " Back: all steps.",
        "Red: a hit with its",
        " own values.",
        "Hold Shift: see all",
        " edited steps.",
        "Random+step: mark a",
        " retrigger step.",
        " Random, groove,",
        " phrase and style",
        " start again there.",
        "Pink with Random or",
        " Delete held.",
        "Left/Right: steps",
        " 17-64.",
        "Shift+Left/Right:",
        " rotate.",
        "Delete+step: clear",
        " hand edits."
      ]
    },
    {
      "title": "Bottom pads",
      "lines": [
        "Touch a knob: the",
        " pads show values",
        " for it. Tap to set.",
        "Pitch: keyboard.",
        " Tap adds or drops",
        " a note and plays",
        " it. Shift+tap:",
        " listen only.",
        "+/-: pad page, or",
        " keyboard octave.",
        "Repeats: Delete",
        " stops running",
        " repeats.",
        "Length: pink pad or",
        " a tap on Delete =",
        " random start.",
        "Shift+pink pad:",
        " back in line."
      ]
    },
    {
      "title": "Left buttons",
      "lines": [
        "Top down: Pattern,",
        " Cycles, Random,",
        " Perform.",
        "Hold: use it.",
        "Press twice: keep",
        " it up.",
        "Press again: off."
      ]
    },
    {
      "title": "Pattern",
      "lines": [
        "Save: Capture, then",
        " tap a slot.",
        "Play: hold Pattern,",
        " tap a pad. Starts",
        " on the quantize",
        " line.",
        "Tap again: now.",
        "Copy+pad+pad: copy.",
        "Delete+pad: clear."
      ]
    },
    {
      "title": "Cycles",
      "lines": [
        "Boxes on screen:",
        " the track's cycles.",
        " Filled: playing.",
        "Hold Cycles, tap a",
        " pad: edit only",
        " that cycle. It",
        " loops.",
        "Press Cycles once:",
        " back to all.",
        "Hold one, tap more:",
        " edit several.",
        "Shift+pad: number",
        " of cycles.",
        "Delete+pad: clear",
        " its edits."
      ]
    },
    {
      "title": "Temp",
      "lines": [
        "Temp is Sample.",
        "Hold it and edit.",
        "Let go: undone.",
        "Press twice: stays",
        " on. Once more:",
        " undone.",
        "Capture: keep the",
        " changes.",
        "Mutes come back",
        " too."
      ]
    },
    {
      "title": "Freeze",
      "lines": [
        "Freeze is Loop.",
        "Hold: the last 4",
        " steps repeat.",
        "Step row: how many",
        " steps repeat.",
        "Track pads: tracks",
        " in or out.",
        "Hold tracks first:",
        " only those.",
        "Press twice: stays",
        " on. Once more: off."
      ]
    },
    {
      "title": "Perform",
      "lines": [
        "16 moves on pads.",
        "Hold: on while held.",
        "Shift+pad: keep on.",
        "Tap it again: off.",
        "Hold track pads to",
        " limit the tracks.",
        "Shift+Perform:",
        " all moves off."
      ]
    },
    {
      "title": "Mute",
      "lines": [
        "Mute+track pads:",
        " applied together",
        " when you let go.",
        "Press Mute twice:",
        " stays on, pads",
        " mute at once.",
        "Press again: off."
      ]
    },
    {
      "title": "Random",
      "lines": [
        "Hold Random, turn a",
        " knob: how far its",
        " value wanders.",
        "Random+jog: chance.",
        "Shift+Random+jog:",
        " rate.",
        "Random and +/-:",
        " loop. Free, or 1,",
        " 2, 4, 8 bars. The",
        " same chances and",
        " random values",
        " come round.",
        "Random+jog click:",
        " new dice for the",
        " track.",
        "Delete+Random:",
        " clear random."
      ]
    },
    {
      "title": "Play and clock",
      "lines": [
        "Play: start/stop.",
        "Shift+Play: clock",
        " Move/Internal/",
        " Computer.",
        "Shift+Menu: output",
        " Move/Computer/Both.",
        "Undo: step back.",
        "Shift+Undo: redo."
      ]
    },
    {
      "title": "Menu and exit",
      "lines": [
        "Menu: Save, Save as,",
        " Load, New, Rename,",
        " Settings.",
        "New: Init or a",
        " starter set.",
        "Jog: move. Click:",
        " choose. Back: up.",
        "Load list: Delete+",
        " click deletes.",
        "Back: step out.",
        "Hold Back: to Move.",
        " E-1 keeps playing.",
        "Shift+Back: quit."
      ]
    }
  ]
}
