{
  "title": "E-1 Lite",
  "children": [
    { "title": "Overview", "lines": [
      "One E-1 track as a",
      "MIDI FX. Plays into",
      "this slot's synth",
      "while Move plays." ] },
    { "title": "Rhythm", "lines": [
      "Steps: loop length.",
      "Pulses: hits, spread",
      " evenly.",
      "Rotate: shift hits.",
      "Div: step length.",
      "Length: bars before",
      " restart (Off=free)." ] },
    { "title": "CC mode", "lines": [
      "Setup > Type = CC",
      "sends CC lanes on",
      "each pulse instead",
      "of notes." ] }
  ]
}
